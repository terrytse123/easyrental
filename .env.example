# Supabase → Project Settings → Database → Connection string → URI
# Choose "Session pooler", region Singapore (closest to Hong Kong).
# Do not use the direct connection (db.<id>.supabase.co). It is often IPv6-only.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Better Auth signing secret (required in production)
# BETTER_AUTH_SECRET=

# Protects /api/renewal (Vercel cron). Header: Authorization: Bearer <CRON_SECRET>
# CRON_SECRET=

# Email: prefer Resend; otherwise SMTP
# RESEND_API_KEY=
# MAIL_FROM=EasyRentalHK <you@yourdomain.com>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
